rules_version = '2';

// Squzo. backups/{uid} is your private automatic backup (only you can read it). Friends only ever
// see what the app shares: name, character, level, streak, weekly XP and finished quests / runs / badges.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    // `owner` has added the signed-in user as a friend.
    function friendOf(owner) { return exists(/databases/$(db)/documents/friends/$(owner)/list/$(me())); }
    function requested(to, from) { return exists(/databases/$(db)/documents/requests/$(to)/from/$(from)); }

    // Field checks, so nobody can save fake numbers or huge blobs (the app never sends anything bigger).
    function d() { return request.resource.data; }
    function str(v, max) { return v is string && v.size() <= max; }
    function optStr(k, max) { return !(k in d()) || str(d()[k], max); }
    function numIn(v, lo, hi) { return v is number && v >= lo && v <= hi; }
    function optNum(k, lo, hi) { return !(k in d()) || numIn(d()[k], lo, hi); }
    function friendCode(v) { return v is string && v.matches('^[A-Z]{3,4}-[0-9]{4}$'); }
    // Weekly XP ceiling: 25 epic quests a day (90 XP) with a lucky crit (×1.5), a 2× daily-box boost and
    // the full legendary bonus (+5%) is ~7,100 a day, ~50,000 a week. Nobody real gets close.
    function maxWeekXp() { return 50000; }

    // Profile pictures: Google account photos only, so nobody can make friends' phones load their own
    // server (and log their IP addresses).
    function optPicture() {
      return !('picture' in d()) || (str(d().picture, 500) && d().picture.matches('^https://lh[0-9][.]googleusercontent[.]com/.*'));
    }

    function validProfile() {
      return d().keys().hasOnly(['name', 'code', 'look', 'level', 'streak', 'weekXp', 'week', 'active', 'picture', 'updatedAt'])
        && str(d().name, 40) && friendCode(d().code)
        && optStr('look', 4000) && optStr('week', 10) && optStr('active', 400) && optPicture()
        && optNum('level', 0, 200) && optNum('streak', 0, 3650) && optNum('weekXp', 0, maxWeekXp())
        && optNum('updatedAt', 0, 4102444800000);
    }

    function validPlayer() {
      return d().keys().hasOnly(['name', 'level', 'weekXp', 'look', 'at'])
        && str(d().name, 40) && numIn(d().level, 0, 200) && numIn(d().weekXp, 0, maxWeekXp())
        && optStr('look', 4000) && optNum('at', 0, 4102444800000);
    }

    // `at` (the phone's clock, in ms) must be close to the server's clock, so nobody can back-date or
    // pre-date a flood of items. Activity may be a few days old (sent after being offline).
    function nearNow(v, pastMs, futureMs) {
      return v is number && v > request.time.toMillis() - pastMs && v < request.time.toMillis() + futureMs;
    }

    function validActivity() {
      return d().keys().hasOnly(['kind', 'text', 'icon', 'value', 'at'])
        && d().kind in ['quest', 'run', 'streak', 'level', 'perfect', 'badge']
        && str(d().text, 200) && str(d().icon, 32) && optNum('value', 0, 100000)
        && nearNow(d().at, 7 * 86400000, 600000);
    }

    function validCheer() {
      return d().keys().hasOnly(['fromUid', 'fromName', 'text', 'at', 'squad'])
        && d().fromUid == me() && str(d().fromName, 40) && str(d().text, 200)
        && nearNow(d().at, 3600000, 600000);
    }

    // Squads and challenges (round 2). Their id is an 8-character join code: knowing it = invited.
    function joinCode(c) { return c.matches('^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{8}$'); }
    function squad(c) { return get(/databases/$(db)/documents/squads/$(c)).data; }
    function inSquad(c, uid) { return joinCode(c) && uid in squad(c).members; }
    // A cheer from a squad mate who isn't a friend names the squad you share.
    function squadMates(uid) { return 'squad' in d() && d().squad is string && inSquad(d().squad, me()) && inSquad(d().squad, uid); }
    function namesOnlyMe() { return d().names.diff(resource.data.names).affectedKeys().hasOnly([me()]) && (!(me() in d().names) || str(d().names[me()], 40)); }
    function challengeQuest(l, i) {
      return l.size() <= i || (l[i] is map && l[i].keys().hasOnly(['title', 'icon']) && str(l[i].title, 60) && str(l[i].icon, 16));
    }

    function blocked(owner, other) { return exists(/databases/$(db)/documents/blocks/$(owner)/list/$(other)); }

    function validChallengePlayer() {
      return d().keys().hasOnly(['name', 'score', 'fullDays', 'finished', 'at'])
        && str(d().name, 20) && numIn(d().score, 0, 180) && numIn(d().fullDays, 0, 30)
        && d().finished is bool && d().at == request.time;
    }

    // Friend request. createdAt must be the server's own clock (the app sends "server time").
    function validRequest() {
      return d().keys().hasOnly(['name', 'code', 'at', 'createdAt'])
        && str(d().name, 40) && friendCode(d().code) && optNum('at', 0, 4102444800000)
        && d().createdAt == request.time;
    }

    // Your automatic backup: only you can read or write it.
    match /backups/{uid} {
      allow read, write: if signedIn() && me() == uid;
    }

    // Public card: readable one at a time by id (a friend's uid). Nobody can list all profiles.
    match /profiles/{uid} {
      allow get: if signedIn();
      allow create, update: if signedIn() && me() == uid && validProfile();
      allow delete: if signedIn() && me() == uid;
    }

    // Friend codes: codes/{code} → { uid }. Look one up by its exact code; nobody can list them.
    // A code can be claimed once (create only), only for yourself and only if it's your profile's code,
    // and removed only by its owner (the app removes the old one when your code changes).
    match /codes/{code} {
      allow get: if signedIn();
      // Only a real friend code, and only the one already saved in your own profile (no squatting).
      allow create: if signedIn() && friendCode(code)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == me()
        && get(/databases/$(db)/documents/profiles/$(me())).data.code == code;
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // Friend requests: written by the sender, read / removed by either side.
    match /requests/{to}/from/{from} {
      allow read, delete: if signedIn() && (me() == to || me() == from);
      // One request per person; sending it again is allowed at most once an hour.
      allow create: if signedIn() && me() == from && to != from && validRequest() && !blocked(to, from);
      allow update: if signedIn() && me() == from && to != from && validRequest()
        && resource.data.createdAt is timestamp && request.time > resource.data.createdAt + duration.value(1, 'h')
        && !blocked(to, from);
    }

    // Friend lists. Accepting a request writes both sides.
    match /friends/{uid}/list/{fid} {
      allow read: if signedIn() && me() == uid;
      allow create, update: if signedIn() && d().keys().hasOnly(['at']) && optNum('at', 0, 4102444800000) && (
        (me() == uid && requested(uid, fid)) ||
        (me() == fid && requested(fid, uid))
      );
      allow delete: if signedIn() && (me() == uid || me() == fid);
    }

    // What you did (quests, runs, streaks…): visible to you and your friends only.
    match /activity/{uid}/items/{id} {
      allow read: if signedIn() && (me() == uid || friendOf(uid));
      allow create: if signedIn() && me() == uid && validActivity();
      allow delete: if signedIn() && me() == uid;
    }

    // Public weekly leaderboard: only people who turned it on (first name, level, weekly XP).
    match /boards/{week}/players/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && me() == uid && week.matches('^[0-9]{4}-W[0-9]{2}$') && validPlayer();
      allow delete: if signedIn() && me() == uid;
    }

    // "Report cheating" on the public board: one note per reporter per player, readable only by the
    // admin (push sender), so reports can't be used to see who reported whom.
    match /reports/{target}/from/{from} {
      allow create: if signedIn() && me() == from && target != from
        && d().keys().hasOnly(['week', 'weekXp', 'level', 'at'])
        && str(d().week, 10) && numIn(d().weekXp, 0, 1000000) && numIn(d().level, 0, 1000)
        && d().at == request.time;
    }

    // Push reminders: your reminder plan + push address, written by the app, read by the server.
    match /push/{uid} {
      allow read, write: if signedIn() && me() == uid;
    }

    // Public settings the server writes (e.g. the push public key, which is public by design).
    match /config/{doc} {
      allow read: if true;
    }

    // Motivational push plan per phone, keyed by a long random token made on that phone (no sign-in
    // needed). Write-only for the app; only the push sender (admin) can read it.
    match /pushQueue/{token} {
      // No sign-in on purpose: notifications must work for people who never connect Google.
      // A real plan (4 messages a day for 14 days + push address) measures ~12.6 KB, so 20 KB is plenty;
      // updatedAt must be the phone's "now" (within a day of the server clock).
      // host = the push service the address points at. Only real push services are allowed (the push
      // sender checks the address itself too, see functions/pushSafety.js; keep the two lists in sync).
      allow create, update: if token.matches('^[0-9a-f]{32,64}$')
        && d().keys().hasOnly(['data', 'updatedAt', 'host'])
        && str(d().data, 20000)
        && d().host is string
        && d().host.matches('^(fcm[.]googleapis[.]com|android[.]googleapis[.]com|([a-z0-9-]+[.])*push[.]services[.]mozilla[.]com|web[.]push[.]apple[.]com|([a-z0-9-]+[.])*push[.]apple[.]com|([a-z0-9-]+[.])*notify[.]windows[.]com|none)$')
        && d().updatedAt is int
        && d().updatedAt > request.time.toMillis() - 86400000
        && d().updatedAt < request.time.toMillis() + 86400000;
      // Whoever holds the token (only that phone) can remove it ("Delete my cloud data").
      allow delete: if token.matches('^[0-9a-f]{32,64}$');
    }

    // Apple Health steps inbox: an iPhone Shortcut writes today's step total here, the app reads it.
    // The document name is a long random secret only your app and your Shortcut know; it holds a single
    // number and nothing about who you are, so no sign-in is needed.
    match /stepsInbox/{token} {
      // The token is 32 hex characters made by the app (src/lib/healthSteps.ts newStepsToken).
      allow get: if token.matches('^[0-9a-f]{32,64}$');
      allow create, update: if token.matches('^[0-9a-f]{32,64}$')
        && request.resource.data.keys().hasOnly(['steps'])
        && request.resource.data.steps is number
        && request.resource.data.steps >= 0 && request.resource.data.steps < 200000;
      allow delete: if token.matches('^[0-9a-f]{32,64}$');
    }

    // Cheers from friends. The id is "<your uid>_<activity item id>" and can only be created once,
    // so it's one cheer per friend per thing they did.
    match /cheers/{uid}/items/{id} {
      allow read, delete: if signedIn() && me() == uid;
      allow create: if signedIn() && (friendOf(uid) || squadMates(uid)) && validCheer() && !blocked(uid, me())
        && id.matches('^' + me() + '_[A-Za-z0-9_-]{1,64}$');
    }

    // Squads: up to 10 people, found only by their join code. Members are a list of uids; `names`
    // holds each member's first name. You can only add or remove yourself (the owner can remove people).
    match /squads/{code} {
      allow get: if signedIn() && joinCode(code);
      allow create: if signedIn() && joinCode(code)
        && d().keys().hasOnly(['name', 'owner', 'members', 'names', 'createdAt'])
        && str(d().name, 30) && d().owner == me()
        && d().members == [me()] && d().names.keys().hasOnly([me()]) && str(d().names[me()], 40)
        && d().createdAt == request.time;
      allow update: if signedIn()
        && d().diff(resource.data).affectedKeys().hasOnly(['members', 'names'])
        && d().members is list && d().members.size() <= 10 && namesOnlyMe()
        && (
          // join
          (!(me() in resource.data.members) && d().members.size() == resource.data.members.size() + 1
            && d().members.toSet() == resource.data.members.toSet().union([me()].toSet()))
          // leave, or the owner removes someone
          || (d().members.size() == resource.data.members.size() - 1 && resource.data.members.toSet().hasAll(d().members.toSet())
            && (me() == resource.data.owner || !(me() in d().members)))
          // change your own name
          || (d().members == resource.data.members && me() in d().members)
        );
      allow delete: if signedIn() && resource.data.owner == me();

      // Squad feed: what members finished, readable by members only. One item per thing done.
      match /feed/{id} {
        allow read: if signedIn() && inSquad(code, me());
        allow create: if signedIn() && inSquad(code, me())
          && id.matches('^' + me() + '_[A-Za-z0-9_-]{1,64}$')
          && d().keys().hasOnly(['uid', 'name', 'kind', 'text', 'icon', 'at'])
          && d().uid == me() && str(d().name, 40)
          && d().kind in ['quest', 'run', 'streak', 'level', 'perfect', 'badge', 'challenge']
          && str(d().text, 200) && str(d().icon, 32) && nearNow(d().at, 7 * 86400000, 600000);
        allow delete: if signedIn() && resource.data.uid == me();
      }
    }

    // Challenges: anyone with the link can read one (no sign-in, so people can look before joining).
    match /challenges/{code} {
      allow get: if joinCode(code);
      allow create: if signedIn() && joinCode(code)
        && d().keys().hasOnly(['title', 'host', 'hostName', 'days', 'start', 'quests', 'badge', 'createdAt'])
        && d().host == me() && str(d().title, 60) && str(d().hostName, 40) && str(d().badge, 16)
        && d().days in [7, 14, 30] && d().start is string && d().start.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d().quests is list && d().quests.size() >= 1 && d().quests.size() <= 6
        && challengeQuest(d().quests, 0) && challengeQuest(d().quests, 1) && challengeQuest(d().quests, 2)
        && challengeQuest(d().quests, 3) && challengeQuest(d().quests, 4) && challengeQuest(d().quests, 5)
        && d().createdAt == request.time;
      allow delete: if signedIn() && resource.data.host == me();

      // Leaderboard: first name + score. Public to read; you write only your own row, at most every 30 s.
      match /players/{uid} {
        allow read: if joinCode(code);
        allow create: if signedIn() && me() == uid && validChallengePlayer()
          && exists(/databases/$(db)/documents/challenges/$(code));
        allow update: if signedIn() && me() == uid && validChallengePlayer()
          && request.time > resource.data.at + duration.value(30, 's');
        allow delete: if signedIn() && me() == uid;
      }
    }

    // People you blocked: they can't send you requests or cheers. Only you see your list.
    match /blocks/{uid}/list/{bid} {
      allow read, delete: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid && bid != uid
        && d().keys().hasOnly(['at']) && optNum('at', 0, 4102444800000);
    }
  }
}
